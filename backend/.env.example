# PostgreSQL (Railway -> Postgres -> Connect -> DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/trustwork

# Секрет для подписи JWT (в production обязателен, сгенерировать: openssl rand -hex 32)
JWT_SECRET=change-me

PORT=3000
NODE_ENV=development

# dev — SMS не отправляется, код пишется в лог сервера
# sms_ru — боевая отправка через sms.ru (нужен SMSRU_API_KEY из личного кабинета)
SMS_PROVIDER=dev
# SMSRU_API_KEY=

# mock — эскроу без реальных денег (по умолчанию)
# yookassa — боевой эскроу: нужны ключи магазина и вебхук
#   https://api.trustwork/api/payments/yookassa/webhook (событие payment.waiting_for_capture)
PAYMENT_PROVIDER=mock
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# PAYMENT_RETURN_URL=https://trustwork-pwa-production.up.railway.app
