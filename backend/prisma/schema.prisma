generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FREELANCER
}

// OPEN добавлен в конец: порядок значений соответствует порядку enum в Postgres
// (ALTER TYPE ADD VALUE дописывает в конец). Сортировка ленты по status asc
// ставит FUNDED (эскроу) раньше OPEN.
enum ProjectStatus {
  DRAFT
  PENDING_PAYMENT
  FUNDED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OPEN
}

enum ReviewKind {
  DIALOG
  DEAL
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Кто может открыть вложение проекта. Список файлов виден всем в любом случае —
// закрытые помечены замком и открываются только откликнувшимся.
enum FileVisibility {
  PUBLIC
  APPLICANTS
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// PENDING добавлен в конец: порядок значений соответствует enum в Postgres
enum TransactionStatus {
  HOLDED
  RELEASED
  REFUNDED
  PENDING
}

model User {
  id             String   @id @default(cuid())
  phone          String   @unique
  role           Role     @default(FREELANCER)
  name           String?
  bio            String?
  skills         String[] @default([])
  rating         Float    @default(0)
  reviewsCount   Int      @default(0)
  completedDeals Int      @default(0)
  telegram       String?
  github         String?
  isVerified     Boolean  @default(false)
  // Доступ к странице владельца: поддержка и арбитраж
  isAdmin        Boolean  @default(false)
  // Фото профиля: хранится в БД, отдается через /api/users/:id/avatar
  avatarData     Bytes?
  avatarMime     String?
  avatarAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientProjects     Project[]     @relation("ClientProjects")
  freelancerProjects Project[]     @relation("FreelancerProjects")
  applications       Application[]
  sentMessages       Message[]     @relation("SentMessages")
  receivedMessages   Message[]     @relation("ReceivedMessages")
  reviewsReceived    Review[]      @relation("SubjectReviews")
  reviewsAuthored    Review[]      @relation("AuthoredReviews")
  supportMessages    SupportMessage[]
  appeals            ReviewAppeal[]   @relation("AuthoredAppeals")
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  budget       Int
  currency     String        @default("RUB")
  tags         String[]      @default([])
  deadline     DateTime?
  status       ProjectStatus @default(DRAFT)
  clientId     String
  client       User          @relation("ClientProjects", fields: [clientId], references: [id])
  freelancerId String?
  freelancer   User?         @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]
  transactions Transaction[]
  messages     Message[]
  reviews      Review[]
  files        ProjectFile[]

  @@index([status, createdAt])
}

// Вложения к задаче (ТЗ, примеры). Содержимое лежит в БД: для MVP этого хватает,
// лимиты — 10 МБ на файл и 5 файлов на проект.
model ProjectFile {
  id         String         @id @default(cuid())
  name       String
  mimeType   String
  size       Int
  data       Bytes
  visibility FileVisibility @default(PUBLIC)
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([projectId])
}

// Двусторонняя оценка по проекту. subject — кого оценивают, author — кто.
// Фрилансер → заказчик: после диалога DIALOG (факт-теги), после сделки DEAL (звезды).
// Заказчик → исполнитель: только DEAL после завершенной сделки.
model Review {
  id        String     @id @default(cuid())
  kind      ReviewKind
  rating    Int?
  tags      String[]   @default([])
  comment   String?
  // Отзыв скрыт по итогам обжалования: в рейтинг и в списки не попадает
  hiddenAt  DateTime?
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  subjectId String
  subject   User       @relation("SubjectReviews", fields: [subjectId], references: [id])
  authorId  String
  author    User       @relation("AuthoredReviews", fields: [authorId], references: [id])
  createdAt DateTime   @default(now())

  appeals ReviewAppeal[]

  @@unique([projectId, authorId])
  @@index([subjectId, kind])
}

// Обжалование отзыва тем, о ком он написан. Решение принимает владелец платформы.
model ReviewAppeal {
  id         String       @id @default(cuid())
  reviewId   String
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation("AuthoredAppeals", fields: [authorId], references: [id])
  reason     String
  status     AppealStatus @default(PENDING)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([reviewId])
}

model Application {
  id           String            @id @default(cuid())
  pitch        String
  status       ApplicationStatus @default(PENDING)
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  freelancerId String
  freelancer   User              @relation(fields: [freelancerId], references: [id])
  createdAt    DateTime          @default(now())

  @@unique([projectId, freelancerId])
}

model Transaction {
  id         String            @id @default(cuid())
  amount     Int
  currency   String            @default("RUB")
  status     TransactionStatus @default(HOLDED)
  provider   String            @default("mock")
  externalId String?
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([projectId, status])
}

model Message {
  id          String    @id @default(cuid())
  text        String
  wasMasked   Boolean   @default(false)
  readAt      DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([recipientId, readAt])
}

// Диалог пользователя с поддержкой: у каждого пользователя одна ветка.
// fromSupport — сообщение написано владельцем со страницы поддержки.
model SupportMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  fromSupport Boolean   @default(false)
  text        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([fromSupport, readAt])
}

model VerificationCode {
  id        String    @id @default(cuid())
  phone     String
  code      String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}
